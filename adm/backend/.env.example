SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Desabilitado por padrão (app em fase de teste, acessível pela internet).
# Mude para true temporariamente quando precisar criar um novo usuário da
# equipe, depois volte para false.
ALLOW_REGISTRATION=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# SQLite por padrão. Em produção, aponte para Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shalom_adm
DATABASE_URL=sqlite:///./adm.db

CORS_ORIGINS=["*"]
