## Exemplo de configuração Nginx para o Shalom ADM.
## Gerado automaticamente por deploy.sh em /etc/nginx/sites-available/shalom-adm.conf
## (mantido aqui só como referência/backup).

server {
    listen 669;
    listen [::]:669;
    server_name _;

    # Frontend estático (HTML/JS/CSS puro)
    root /opt/shalom-adm/adm/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API (proxy para o Gunicorn/Uvicorn rodando via systemd)
    location /api/ {
        proxy_pass http://127.0.0.1:8010/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    access_log /var/log/nginx/shalom-adm.access.log;
    error_log  /var/log/nginx/shalom-adm.error.log;
}
