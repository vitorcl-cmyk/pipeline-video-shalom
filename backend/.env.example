# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# Gere um valor forte, por exemplo: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de dados. Para produção, prefira Postgres:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/reels_db
DATABASE_URL=sqlite:///./app.db

# Diretórios de armazenamento (fotos enviadas e vídeos gerados)
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs

# Regras de negócio
DAILY_VIDEO_LIMIT=10
MAX_PHOTOS_PER_JOB=20
MAX_UPLOAD_MB=15

# FFmpeg (caminho do binário; use apenas "ffmpeg" se estiver no PATH)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# CORS - origens permitidas separadas por vírgula será convertido pelo pydantic;
# em produção, restrinja ao domínio do seu frontend, ex:
# CORS_ORIGINS=["https://meusite.com"]
CORS_ORIGINS=["*"]
